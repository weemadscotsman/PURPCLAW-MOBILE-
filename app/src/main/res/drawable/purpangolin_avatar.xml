<?xml version="1.0" encoding="utf-8"?>
<!--
  PurpAngolin avatar — single vector sheet built from primitives.
  Placeholder for the real Meshy GLB / art asset (task #50/#53).
  This file is the CANONICAL fallback when the GLB is missing on the
  device, and the rotation target so the operator can hand-key the swap.

  Anatomy (clockwise from snout):
    snout → head → armored plate stack (5 plates) → tail curl → belly → legs.

  All strokes are dark purple on a transparent background so the same
  asset can sit on top of any surface — chat bubble, boot screen, header,
  podcast tile. State-driven tint / glow happens in code via
  PurpAngolinAvatar.kt (`animatedTint(...)`, `glow(...)`).

  Bounds: viewBox 0 0 256 256. Centre is (128, 128). Tail tip at (210, 160).
  Plate row centreline at y=110 (the body's weighted mass point).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="256dp"
    android:height="256dp"
    android:viewportWidth="256"
    android:viewportHeight="256">

  <!-- Outer glow halo (transparent purple, painted behind the body so the
       tint modulator in code can pulse this layer without disturbing the
       line work). -->
  <path
      android:pathData="M128 30 m -84 0 a 84 84 0 1 0 168 0 a 84 84 0 1 0 -168 0"
      android:fillColor="#33B388FF"
      android:fillAlpha="0.0" />

  <!-- Body silhouette — an oblong pangolin shape from snout to tail. -->
  <path
      android:pathData="M40 130
                       C 40 110, 60 90, 90 88
                       C 100 86, 110 84, 120 84
                       C 140 84, 160 88, 180 96
                       C 200 104, 215 118, 220 134
                       C 222 142, 220 152, 212 158
                       C 198 168, 178 172, 158 172
                       C 130 172, 100 168, 78 160
                       C 60 154, 42 146, 40 130 Z"
      android:fillColor="#6A4FB6"
      android:strokeColor="#3D1F8C"
      android:strokeWidth="3" />

  <!-- Belly highlight (lighter purple underneath the body). -->
  <path
      android:pathData="M52 144
                       C 70 156, 110 168, 160 168
                       C 180 168, 200 164, 210 158
                       C 200 168, 178 172, 158 172
                       C 130 172, 100 168, 78 160
                       C 64 156, 56 150, 52 144 Z"
      android:fillColor="#9A7AE6"
      android:fillAlpha="0.55" />

  <!-- Armor plate stack — five overlapping scallops along the back.
       Each plate is a filled curved cap. -->
  <path
      android:pathData="M96 88 C 100 78, 110 76, 114 88 L 114 110 L 96 110 Z"
      android:fillColor="#8C5FE0"
      android:strokeColor="#3D1F8C"
      android:strokeWidth="2" />
  <path
      android:pathData="M118 84 C 122 72, 134 72, 138 84 L 138 112 L 118 112 Z"
      android:fillColor="#A675F0"
      android:strokeColor="#3D1F8C"
      android:strokeWidth="2" />
  <path
      android:pathData="M142 84 C 146 72, 158 72, 162 84 L 162 114 L 142 114 Z"
      android:fillColor="#8C5FE0"
      android:strokeColor="#3D1F8C"
      android:strokeWidth="2" />
  <path
      android:pathData="M166 88 C 170 76, 182 78, 186 90 L 186 114 L 166 114 Z"
      android:fillColor="#A675F0"
      android:strokeColor="#3D1F8C"
      android:strokeWidth="2" />
  <path
      android:pathData="M190 96 C 194 86, 206 88, 210 102 L 210 116 L 190 116 Z"
      android:fillColor="#8C5FE0"
      android:strokeColor="#3D1F8C"
      android:strokeWidth="2" />

  <!-- Tail curl — three concentric arcs from rump to tail tip. -->
  <path
      android:pathData="M210 134 C 232 130, 244 150, 232 168 C 222 180, 208 174, 206 162"
      android:strokeColor="#3D1F8C"
      android:strokeWidth="6"
      android:strokeLineCap="round" />
  <path
      android:pathData="M212 138 C 226 138, 234 154, 226 166 C 220 174, 212 170, 210 162"
      android:strokeColor="#6A4FB6"
      android:strokeWidth="3"
      android:strokeLineCap="round" />

  <!-- Head — snout extends left from body, eye + ear dot. -->
  <path
      android:pathData="M40 130 C 32 130, 26 134, 28 142 C 30 150, 40 152, 50 150 L 60 146 L 60 134 Z"
      android:fillColor="#6A4FB6"
      android:strokeColor="#3D1F8C"
      android:strokeWidth="2" />
  <path
      android:pathData="M44 132 C 40 132, 38 134, 40 138 C 42 140, 46 138, 46 134 Z"
      android:fillColor="#FFFFFF" />
  <path
      android:pathData="M42 135 C 41 135, 41 136, 42 136 C 43 136, 43 135, 42 135 Z"
      android:fillColor="#000000" />
  <!-- Ear -->
  <path
      android:pathData="M58 122 C 58 116, 64 116, 64 122 L 64 130 L 58 130 Z"
      android:fillColor="#A675F0"
      android:strokeColor="#3D1F8C"
      android:strokeWidth="2" />

  <!-- Four legs poking out under the body — two fore, two hind. -->
  <path
      android:pathData="M76 168 L 76 184 C 76 188, 80 188, 80 184 L 80 170 Z"
      android:fillColor="#3D1F8C" />
  <path
      android:pathData="M104 172 L 104 188 C 104 192, 108 192, 108 188 L 108 174 Z"
      android:fillColor="#3D1F8C" />
  <path
      android:pathData="M146 172 L 146 188 C 146 192, 150 192, 150 188 L 150 174 Z"
      android:fillColor="#3D1F8C" />
  <path
      android:pathData="M178 168 L 178 184 C 178 188, 182 188, 182 184 L 182 170 Z"
      android:fillColor="#3D1F8C" />

  <!-- Snout accent: tiny claw/notch (matches the operator's wordmark "the
       CLAW"). -->
  <path
      android:pathData="M28 142 L 22 138 L 22 146 Z"
      android:fillColor="#3D1F8C" />
</vector>
