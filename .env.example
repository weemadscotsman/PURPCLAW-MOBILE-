# API keys for PurpClaw Mobile runtime
# PurpClaw uses provider-routers (OpenRouter, NIM, MiniMax, etc.) — keys are optional
# Set only the keys you configure via the app's Settings → AI & Models screen

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
NVIDIA_NIM_API_KEY=YOUR_NVIDIA_NIM_API_KEY
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY
LONGCAT_API_KEY=YOUR_LONGCAT_API_KEY